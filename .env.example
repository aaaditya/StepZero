# Digits only with country code. Example: 919876543210
NEXT_PUBLIC_WHATSAPP_E164=

# Optional Google Analytics measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to skip loading analytics scripts.
NEXT_PUBLIC_GA_ID=

# Optional city for local SEO / contact (e.g. Bengaluru). Leave empty for India-wide.
NEXT_PUBLIC_CITY=

# Optional social profile URLs (included in JSON-LD sameAs only when set).
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=
